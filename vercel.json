{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/academy/article.ts": {
      "includeFiles": "content/academy/**"
    },
    "api/garden/generate-care-tasks.ts": {
      "includeFiles": "content/garden/**"
    }
  }
}
